---
// Fixed bottom bar with booking actions, phones only.
import { primaryAction, phoneIsPrimary, telHref } from '../lib/booking';

interface Props {
  service?: string;
  option?: string;
}
const { service, option } = Astro.props;
const primary = primaryAction(service, option);
---
<nav class="bar dark" aria-label="Objednání">
  <a
    class="bar-primary"
    href={primary.href}
    data-book-primary
    {...(primary.external ? { target: '_blank', rel: 'noopener' } : {})}
  >{primary.label}</a>
  {!phoneIsPrimary() && <a class="bar-call" href={telHref()}>Zavolat</a>}
</nav>

<style>
  .bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 50;
    display: flex;
    gap: 0.5rem;
    padding: 0.6rem var(--gutter) calc(0.6rem + env(safe-area-inset-bottom));
    background: color-mix(in oklch, var(--green-950) 94%, transparent);
    border-top: 1px solid var(--line);
    backdrop-filter: blur(8px);
  }
  .bar a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 400;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
  }
  .bar-primary {
    flex: 1 1 auto;
    background: var(--gold);
    color: var(--green-950);
  }
  .bar-call {
    flex: 0 0 34%;
    border: 1px solid var(--line);
    color: var(--fg);
  }
  @media (min-width: 48rem) {
    .bar {
      display: none;
    }
  }
</style>
