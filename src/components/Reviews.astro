---
// Renders only real reviews from src/data/reviews.ts. Empty list -> Google link (if set) -> nothing.
import { reviews } from '../data/reviews';
import { site } from '../data/site';
import { findService } from '../data/services';
const showLink = !reviews.length && site.googleReviewsUrl;
---
{reviews.length > 0 && (
  <section class="section paper-2" aria-labelledby="reviews-title">
    <div class="wrap">
      <p class="eyebrow">Recenze</p>
      <h2 id="reviews-title">Co říkají ostatní</h2>
      <div class="list">
        {reviews.map((r) => (
          <figure>
            <blockquote><p>{r.text}</p></blockquote>
            <figcaption>
              {r.author}
              <span class="src"> · {r.source}{r.service && findService(r.service) && ` · ${findService(r.service)!.service.name}`}</span>
            </figcaption>
          </figure>
        ))}
      </div>
      {site.googleReviewsUrl && (
        <p><a class="text-link" href={site.googleReviewsUrl} rel="noopener" target="_blank">Další recenze na Googlu</a></p>
      )}
    </div>
  </section>
)}
{showLink && (
  <section class="section paper-2 compact" aria-label="Recenze">
    <div class="wrap">
      <p class="muted">Zkušenosti návštěvníků najdete na Googlu.</p>
      <a class="text-link" href={site.googleReviewsUrl} rel="noopener" target="_blank">Přečíst recenze na Googlu</a>
    </div>
  </section>
)}

<style>
  .list {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    margin: 3rem 0 2rem;
  }
  figure {
    margin: 0;
  }
  blockquote {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.5;
  }
  figcaption {
    font-size: 0.95rem;
  }
  .src {
    color: var(--fg-soft);
  }
  .compact {
    padding-block: 3.5rem;
    text-align: center;
  }
  .compact p {
    margin-bottom: 0.25rem;
  }
</style>
