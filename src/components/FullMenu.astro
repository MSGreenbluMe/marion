---
import { categories, serviceUrl } from '../data/services';
import { fromPrice } from '../lib/format';
---
<section class="section light-2" id="nabidka" aria-labelledby="menu-title">
  <div class="wrap">
    <p class="eyebrow">Celá nabídka</p>
    <h2 id="menu-title">Masáže, meditace a rituály</h2>
    <p class="lead">Vyberte si péči, která vás právě teď nejlépe podpoří na cestě k rovnováze.</p>
    <div class="cols">
      {categories.map((c) => (
        <div>
          <h3><a href={`/${c.id}`}>{c.name}</a></h3>
          <ul>
            {c.services.map((s) => (
              <li>
                <a href={serviceUrl(c.id, s.slug)}>
                  <span class="name">{s.name}</span>
                  <span class="price">{fromPrice(s)}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .cols {
    display: grid;
    gap: 3rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    margin-top: 3rem;
  }
  h3 a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-light);
  }
  li a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    min-height: 52px;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line-light);
    text-decoration: none;
  }
  li a:hover .name {
    text-decoration: underline;
  }
  .price {
    white-space: nowrap;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
</style>
