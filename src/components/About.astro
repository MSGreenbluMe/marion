---
import { site } from '../data/site';
import Paint from './Paint.astro';
const { about, ownerFirstName } = site;
// Until the "O mně" text is supplied, a short factual line stands in.
const paragraphs = about.paragraphs.length
  ? about.paragraphs
  : [`Jsem ${ownerFirstName} a ve svém studiu v Hradci Králové nabízím masáže, meditace a ženské rituály.`];
const hasPortrait = Boolean(about.portrait.src);
---
<section class="section paper-2 clip about" id="o-mne" aria-labelledby="about-title">
  <div class="wrap grid">
    <div class="visual">
      {hasPortrait ? (
        <div class="frame arch-mask">
          <img src={about.portrait.src} alt={about.portrait.alt || `${ownerFirstName}, ${site.name}`} width="640" height="860" loading="lazy" decoding="async" />
        </div>
      ) : (
        <div class="frame-empty">
          <Paint name="arch-soft" class="arch" />
          <Paint name="lotus" class="lotus" />
        </div>
      )}
      <Paint name="eucalyptus" class="sprig" drift={0.05} />
    </div>

    <div class="text">
      <p class="eyebrow">O mně</p>
      <h2 id="about-title">Cesta zpět <em>k sobě</em></h2>
      {paragraphs.map((p, i) =>
        i === about.highlight ? <p class="quote">{p}</p> : <p>{p}</p>,
      )}
      <p class="signature" aria-hidden="true">{ownerFirstName}</p>

      {about.audioGreeting.src && (
        <div class="audio">
          <p class="muted">Pozdrav ode mě, vlastním hlasem:</p>
          <audio controls preload="none" src={about.audioGreeting.src}></audio>
          {about.audioGreeting.transcript && (
            <details>
              <summary>Přepis nahrávky</summary>
              <p>{about.audioGreeting.transcript}</p>
            </details>
          )}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 3.5rem;
    align-items: center;
  }
  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: 5fr 7fr;
      gap: 5rem;
    }
  }
  .visual {
    position: relative;
    width: min(100%, 26rem);
    margin-inline: auto;
  }
  .frame {
    position: relative;
    aspect-ratio: 3 / 4;
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .frame-empty {
    position: relative;
  }
  .frame-empty :global(.arch) {
    width: 100%;
  }
  .frame-empty :global(.lotus) {
    position: absolute;
    left: 6%;
    width: 88%;
    bottom: 12%;
  }
  .visual :global(.sprig) {
    position: absolute;
    right: -10%;
    bottom: -14%;
    width: 30%;
    rotate: 24deg;
  }
  .text {
    position: relative;
    max-width: var(--measure);
    font-size: 1.125rem;
  }
  h2 {
    margin-bottom: 1.75rem;
  }
  .quote {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.5rem, 2.8vw, 1.95rem);
    line-height: 1.38;
    color: var(--green-800);
    padding-left: 1.5rem;
    border-left: 2px solid oklch(0.78 0.126 85 / 0.7);
    margin: 2rem 0;
  }
  .signature {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 2.4rem;
    color: var(--gold-deep);
    margin-top: 1.25rem;
    rotate: -3deg;
    transform-origin: left;
    width: fit-content;
  }
  .audio {
    margin-top: 2rem;
  }
  audio {
    width: 100%;
    max-width: 24rem;
  }
  summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
  }
</style>
