---
import { site } from '../data/site';
const { about, ownerFirstName } = site;
// Until the verbatim "O mně" text from the live site is added, a short factual line stands in.
const paragraphs = about.paragraphs.length
  ? about.paragraphs
  : [`Jsem ${ownerFirstName} a ve svém studiu v Hradci Králové nabízím masáže, meditace a ženské rituály.`];
const hasPortrait = Boolean(about.portrait.src);
---
<section class="section about" id="o-mne" aria-labelledby="about-title">
  <div class:list={['wrap', 'grid', { 'has-portrait': hasPortrait }]}>
    {hasPortrait && (
      <figure class="portrait">
        <img src={about.portrait.src} alt={about.portrait.alt || `${ownerFirstName}, ${site.name}`} width="640" height="800" loading="lazy" decoding="async" />
      </figure>
    )}
    <div class="text">
      <p class="eyebrow">O mně</p>
      <h2 id="about-title">{ownerFirstName}</h2>
      <hr class="rule" />
      {paragraphs.map((p) => <p>{p}</p>)}

      {about.audioGreeting.src && (
        <div class="audio">
          <p class="muted">Pozdrav ode mě, vlastním hlasem:</p>
          <audio controls preload="none" src={about.audioGreeting.src}></audio>
          {about.audioGreeting.transcript && (
            <details>
              <summary>Přepis nahrávky</summary>
              <p>{about.audioGreeting.transcript}</p>
            </details>
          )}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 3rem;
  }
  .text {
    max-width: var(--measure);
    font-size: 1.125rem;
  }
  .has-portrait {
    align-items: center;
  }
  @media (min-width: 52rem) {
    .has-portrait {
      grid-template-columns: 5fr 7fr;
      gap: 5rem;
    }
  }
  .portrait {
    margin: 0;
  }
  .portrait img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .audio {
    margin-top: 2rem;
  }
  audio {
    width: 100%;
    max-width: 24rem;
  }
  summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
  }
</style>
