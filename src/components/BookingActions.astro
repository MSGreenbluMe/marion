---
// The one booking component. Primary action comes from site.booking (online booking,
// WhatsApp, SMS or phone). Phone is always offered as the secondary action.
import { site } from '../data/site';
import { primaryAction, phoneIsPrimary, telHref } from '../lib/booking';

interface Props {
  service?: string;
  option?: string;
  align?: 'start' | 'center';
}
const { service, option, align = 'start' } = Astro.props;
const primary = primaryAction(service, option);
const showCall = !phoneIsPrimary();
---
<div class:list={['booking', `align-${align}`]}>
  <a
    class="btn btn-primary"
    href={primary.href}
    data-book-primary
    {...(primary.external ? { target: '_blank', rel: 'noopener' } : {})}
  >{primary.label}</a>
  {showCall && <a class="btn btn-quiet call-btn" href={telHref()}>Zavolat</a>}
  <p class="call-text">
    {showCall ? 'nebo zavolejte' : 'Telefon'}{' '}
    <a href={telHref()}>{site.contact.phoneDisplay}</a>
  </p>
</div>

<style>
  .booking {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .align-center {
    justify-content: center;
  }
  .call-text {
    margin: 0;
    font-size: 0.95rem;
    opacity: 0.85;
  }
  .call-text a {
    white-space: nowrap;
    text-decoration: none;
    font-weight: 400;
    letter-spacing: 0.03em;
  }
  /* Phone: a real "call" button. Desktop: the number as readable text. */
  @media (max-width: 47.99rem) {
    .call-text {
      display: none;
    }
  }
  @media (min-width: 48rem) {
    .call-btn {
      display: none;
    }
  }
</style>
