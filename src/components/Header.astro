---
import { site } from '../data/site';
import { telHref } from '../lib/booking';

const path = Astro.url.pathname.replace(/\.html$/, '');
const nav = [
  { href: '/masaze', label: 'Masáže' },
  { href: '/meditace', label: 'Meditace' },
  { href: '/ritualy', label: 'Rituály' },
  { href: '/terminy', label: 'Termíny' },
  { href: '/poukaz', label: 'Poukaz' },
  { href: '/#kontakt', label: 'Kontakt' },
];
const isCurrent = (href: string) =>
  href !== '/#kontakt' && (path === href || path.startsWith(`/sluzba${href}/`));
---
<header class="header">
  <div class="wrap inner">
    <a class="brand" href="/">{site.name}</a>

    <nav class="nav-desktop" aria-label="Hlavní navigace">
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
      <a class="phone" href={telHref()}>{site.contact.phoneDisplay}</a>
    </nav>

    <details class="nav-mobile">
      <summary>Menu</summary>
      <nav aria-label="Hlavní navigace">
        <ul>
          {nav.map((n) => (
            <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in oklch, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px) saturate(1.1);
    border-bottom: 1px solid color-mix(in oklch, var(--line) 70%, transparent);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.5rem;
  }
  .brand {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a[aria-current='page'] {
    color: var(--gold-deep);
  }
  .nav-desktop {
    display: none;
    align-items: center;
    gap: 2.25rem;
  }
  .nav-desktop ul {
    display: flex;
    gap: 1.6rem;
  }
  .nav-desktop a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    font-size: 0.93rem;
    letter-spacing: 0.04em;
  }
  .nav-desktop ul a {
    position: relative;
  }
  .nav-desktop ul a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.55rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease);
  }
  .nav-desktop ul a:hover::after,
  .nav-desktop ul a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .phone {
    color: var(--ink-soft);
    padding-left: 2rem;
    border-left: 1px solid var(--line);
    white-space: nowrap;
  }
  .nav-mobile summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    min-width: 44px;
    padding: 0 0.25rem;
    cursor: pointer;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }
  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }
  .nav-mobile[open] summary {
    color: var(--gold-deep);
  }
  .nav-mobile nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    padding: 0.5rem var(--gutter) 1.25rem;
    box-shadow: 0 1.5rem 2rem -1.5rem oklch(0.3 0.03 100 / 0.3);
  }
  .nav-mobile a {
    display: flex;
    align-items: center;
    min-height: 54px;
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 300;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 62rem) {
    .nav-desktop {
      display: flex;
    }
    .nav-mobile {
      display: none;
    }
  }
</style>
