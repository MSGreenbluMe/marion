---
// "Jak se dnes cítíte?" — pure CSS (radio + :has), works without JavaScript.
import { chooser } from '../data/chooser';
import { findService } from '../data/services';
import ServiceCard from './ServiceCard.astro';
import Paint from './Paint.astro';

const states = chooser.map((s) => ({
  ...s,
  matches: s.services.map((slug) => findService(slug)).filter((m) => m !== undefined),
}));

// Show the panel of the checked state; generated from the data so new states just work.
const panelCss =
  states
    .map((s) => `.chooser:has(input[value='${s.id}']:checked) .panel[data-state='${s.id}']`)
    .join(',') + '{display:grid}';
---
<section class="section paper-2 clip chooser" id="jak-se-citite" aria-labelledby="chooser-title">
  <Paint name="eucalyptus-2" class="decor" drift={0.06} />
  <div class="wrap">
    <div class="center">
      <p class="eyebrow">Na začátek</p>
      <h2 id="chooser-title">Jak se dnes <em>cítíte?</em></h2>
      <p class="lead">Vyberte, co je vám teď nejblíž. Ukážu vám, co by vám mohlo pomoci.</p>
    </div>

    <fieldset class="chips">
      <legend class="sr-only">Jak se dnes cítíte?</legend>
      {states.map((s) => (
        <span class="chip">
          <input class="sr-only" type="radio" name="feeling" id={`feel-${s.id}`} value={s.id} />
          <label for={`feel-${s.id}`}>
            <span class="swatch"><Paint name={s.art} settle={false} /></span>
            {s.label}
          </label>
        </span>
      ))}
    </fieldset>

    <div class="panels" aria-live="polite">
      <p class="hint">Vyberte jednu z možností výše.</p>
      {states.map((s) => (
        <div class="panel" data-state={s.id}>
          {s.matches.map((m) => <ServiceCard service={m.service} category={m.category} />)}
        </div>
      ))}
    </div>

    <p class="self center">
      <a class="text-link" href="#nabidka">Chci si vybrat sama</a>
    </p>
  </div>
</section>

<style>
  .chooser :global(.decor) {
    position: absolute;
    top: -2rem;
    right: -5rem;
    width: min(16rem, 40vw);
    rotate: 18deg;
    opacity: 0.85;
  }
  .chips {
    border: 0;
    margin: 2.75rem auto 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    max-width: 56rem;
  }
  .chip label {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 56px;
    padding: 0.35rem 1.4rem 0.35rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
    font-size: 1rem;
    background: var(--paper);
    transition: border-color 0.3s var(--ease), background-color 0.3s var(--ease), color 0.3s var(--ease),
      box-shadow 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .chip label:hover {
    border-color: var(--gold-deep);
    box-shadow: 0 0.75rem 1.5rem -1rem oklch(0.4 0.05 90 / 0.5);
  }
  @media (prefers-reduced-motion: no-preference) {
    .chip label:hover {
      transform: translateY(-2px);
    }
  }
  .swatch {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    overflow: hidden;
    background: var(--paper);
    flex-shrink: 0;
  }
  .swatch :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.35);
  }
  .chip input:focus-visible + label {
    outline: 2px solid var(--gold-deep);
    outline-offset: 3px;
  }
  .chip input:checked + label {
    background: var(--green-900);
    border-color: var(--green-900);
    color: var(--paper);
  }
  .chip input:checked + label .swatch :global(img) {
    mix-blend-mode: normal;
  }
  .panels {
    margin: 2.75rem auto 0;
    max-width: 54rem;
  }
  .panel {
    display: none;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }
  @media (prefers-reduced-motion: no-preference) {
    .panel {
      animation: rise 0.6s var(--ease);
    }
  }
  @keyframes rise {
    from {
      opacity: 0.4;
      transform: translateY(8px);
    }
  }
  .hint {
    text-align: center;
    color: var(--fg-soft);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
    margin: 0;
  }
  .chooser:has(input:checked) .hint {
    display: none;
  }
  .self {
    margin: 2.25rem 0 0;
  }
</style>
<style is:inline set:html={panelCss}></style>
