---
// "Jak se dnes cítíte?" — pure CSS (radio + :has), works without JavaScript.
import { chooser } from '../data/chooser';
import { findService } from '../data/services';
import ServiceCard from './ServiceCard.astro';
import Illustration from './Illustration.astro';

const states = chooser.map((s) => ({
  ...s,
  matches: s.services.map((slug) => findService(slug)).filter((m) => m !== undefined),
}));

// Show the panel of the checked state; generated from the data so new states just work.
const panelCss =
  states
    .map((s) => `.chooser:has(input[value='${s.id}']:checked) .panel[data-state='${s.id}']`)
    .join(',') + '{display:block}';
---
<section class="section light chooser" id="jak-se-citite" aria-labelledby="chooser-title">
  <Illustration name="sprig-wide" class="decor" />
  <div class="wrap">
    <div class="center">
      <p class="eyebrow">Na začátek</p>
      <h2 id="chooser-title">Jak se dnes <em>cítíte?</em></h2>
      <p class="lead">Vyberte, co je vám teď nejblíž. Ukážu vám, co by vám mohlo pomoci.</p>
    </div>

    <fieldset class="chips">
      <legend class="sr-only">Jak se dnes cítíte?</legend>
      {states.map((s) => (
        <span class="chip">
          <input class="sr-only" type="radio" name="feeling" id={`feel-${s.id}`} value={s.id} />
          <label for={`feel-${s.id}`}>{s.label}</label>
        </span>
      ))}
    </fieldset>

    <div class="panels" aria-live="polite">
      <div class="hint">
        <Illustration name="lotus" class="hint-icon" />
        <p>Vyberte jednu z možností výše.</p>
      </div>
      {states.map((s) => (
        <div class="panel" data-state={s.id}>
          <div class="cards">
            {s.matches.map((m) => <ServiceCard service={m.service} category={m.category} />)}
          </div>
        </div>
      ))}
    </div>

    <p class="self center">
      <a class="text-link" href="#nabidka">Chci si vybrat sama</a>
    </p>
  </div>
</section>

<style>
  .chooser {
    overflow: hidden;
  }
  .chooser :global(.decor) {
    position: absolute;
    top: 2.5rem;
    right: -3rem;
    width: min(22rem, 60vw);
    color: var(--sage);
    opacity: 0.55;
    rotate: 8deg;
    pointer-events: none;
  }
  .chips {
    border: 0;
    margin: 2.75rem auto 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    max-width: 52rem;
  }
  .chip label {
    display: inline-flex;
    align-items: center;
    min-height: 50px;
    padding: 0.5rem 1.5rem;
    border: 1px solid var(--line-light);
    border-radius: 999px;
    cursor: pointer;
    font-size: 1rem;
    background: oklch(1 0 0 / 0.55);
    transition: border-color 0.25s ease, background-color 0.25s ease, color 0.25s ease;
  }
  .chip label:hover {
    border-color: var(--gold-deep);
  }
  .chip input:focus-visible + label {
    outline: 2px solid var(--gold-deep);
    outline-offset: 3px;
  }
  .chip input:checked + label {
    background: var(--green-900);
    border-color: var(--green-900);
    color: var(--paper);
  }
  .panels {
    margin: 2.75rem auto 0;
    max-width: 52rem;
  }
  .panel {
    display: none;
  }
  .hint {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 2.5rem 1rem;
    border: 1px dashed var(--line-light);
    border-radius: 0.5rem;
    color: var(--ink-soft);
    text-align: center;
  }
  .hint p {
    margin: 0;
  }
  .hint :global(.hint-icon) {
    width: 4rem;
    color: var(--gold-deep);
    --illo-fill: var(--paper);
  }
  .chooser:has(input:checked) .hint {
    display: none;
  }
  .cards {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
  }
  .self {
    margin: 2rem 0 0;
  }
</style>

<style is:inline set:html={panelCss}></style>
