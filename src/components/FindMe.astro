---
import { site, mapsLink } from '../data/site';
import BookingActions from './BookingActions.astro';
import Paint from './Paint.astro';
const c = site.contact;
---
<section class="section clip findme" id="kontakt" aria-labelledby="find-title">
  <div class="wrap">
    <p class="eyebrow">Kontakt</p>
    <h2 id="find-title">Kde mě <em>najdete</em></h2>
    <div class="grid">
      <div class="place">
        <Paint name="stones" class="place-art" />
        <address>
          <span class="street">{c.street}</span>
          <span>{c.postalCode} {c.city}</span>
        </address>
        {(c.floorAndDoorbell || c.parking) && (
          <dl>
            {c.floorAndDoorbell && (<><dt>Vchod</dt><dd>{c.floorAndDoorbell}</dd></>)}
            {c.parking && (<><dt>Parkování</dt><dd>{c.parking}</dd></>)}
          </dl>
        )}
        <a class="btn btn-quiet" href={mapsLink()} target="_blank" rel="noopener">Otevřít v Mapách</a>
      </div>
      <div class="reach">
        <dl>
          <dt>Telefon</dt>
          <dd><a href={`tel:${c.phoneE164}`}>{c.phoneDisplay}</a></dd>
          {c.email && (<><dt>E-mail</dt><dd><a href={`mailto:${c.email}`}>{c.email}</a></dd></>)}
          <dt>Kdy</dt>
          <dd>{c.openingNote}</dd>
        </dl>
        <BookingActions />
      </div>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 2.5rem;
    margin-top: 3rem;
    align-items: center;
  }
  @media (min-width: 52rem) {
    .grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 4rem;
    }
  }
  .place {
    position: relative;
    overflow: hidden;
    border-radius: 999px 999px 1.25rem 1.25rem;
    padding: clamp(5rem, 14vw, 8rem) 2.5rem 2.5rem;
    border: 1px solid var(--line);
    background:
      repeating-linear-gradient(90deg, transparent 0 55px, oklch(0.5 0.03 120 / 0.07) 55px 56px),
      repeating-linear-gradient(0deg, transparent 0 55px, oklch(0.5 0.03 120 / 0.07) 55px 56px),
      var(--grain), var(--paper-2);
    text-align: center;
  }
  .place :global(.place-art) {
    width: 9rem;
    margin: -3rem auto 1rem;
  }
  address {
    position: relative;
    font-style: normal;
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 1.5rem;
    line-height: 1.3;
    margin-bottom: 1.5rem;
  }
  .street {
    font-size: 2rem;
  }
  dl {
    margin: 0 0 1.5rem;
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.5rem 1.5rem;
    text-align: left;
  }
  dt {
    font-size: 0.76rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-soft);
    padding-top: 0.35rem;
  }
  dd {
    margin: 0;
  }
  dd a {
    text-decoration: none;
  }
  dd a:hover {
    text-decoration: underline;
  }
  .reach dl {
    margin-bottom: 2rem;
    font-size: 1.15rem;
  }
</style>
