---
// Turns the quiet sound layer on and off (scripts/sound.ts). Sound is always off until clicked.
---
<button class="sound-toggle" type="button" data-sound-toggle aria-pressed="false" aria-label="Zapnout zvuk"
  title="Tichý zvuk: dech, šepot a vzdálené zvonky">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M4 9.5h3l4-3.5v12l-4-3.5H4z" />
    <path class="w1" d="M15 9.5c.9.8.9 4.2 0 5" />
    <path class="w2" d="M17.6 7.5c2 2 2 7 0 9" />
  </svg>
  <span class="label" data-sound-label>Zvuk</span>
</button>

<style>
  .sound-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    min-width: 44px;
    padding: 0 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    transition: border-color 0.3s var(--ease), background-color 0.3s var(--ease), color 0.3s var(--ease);
  }
  .sound-toggle:hover {
    border-color: var(--gold-deep);
  }
  svg {
    width: 1.35rem;
    height: 1.35rem;
  }
  .w1,
  .w2 {
    opacity: 0.25;
    transition: opacity 0.4s var(--ease);
  }
  .sound-toggle[aria-pressed='true'] {
    background: var(--green-900);
    border-color: var(--green-900);
    color: var(--paper);
  }
  .sound-toggle[aria-pressed='true'] .w1,
  .sound-toggle[aria-pressed='true'] .w2 {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .sound-toggle[aria-pressed='true'] .w2 {
      animation: wave 2.4s ease-in-out infinite;
    }
  }
  @keyframes wave {
    50% {
      opacity: 0.3;
    }
  }
  @media (max-width: 30rem) {
    .label {
      display: none;
    }
  }
</style>
