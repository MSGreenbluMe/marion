---
import { site } from '../data/site';
import { telHref } from '../lib/booking';
import Illustration from './Illustration.astro';
import BrushToggle from './BrushToggle.astro';

const { contact, legal } = site;
const hasLegal = legal.fullName || legal.ico || legal.registeredAddress;
---
<footer class="footer dark dark-2">
  <div class="wrap closing">
    <Illustration name="sprig-wide" class="closing-sprig" />
    <p class="closing-name">{site.name}</p>
    <p class="closing-sub">{site.hero.sub}</p>
  </div>
  <div class="wrap grid">
    <div>
      <p class="brand">{site.name}</p>
      <p class="muted">
        {contact.street}<br />
        {contact.postalCode} {contact.city}
      </p>
    </div>
    <div>
      <p class="muted">
        <a href={telHref()}>{contact.phoneDisplay}</a>
        {contact.email && (<><br /><a href={`mailto:${contact.email}`}>{contact.email}</a></>)}
        <br />{contact.openingNote}
      </p>
    </div>
    <div>
      <ul class="links">
        <li><a href="/masaze">Masáže</a></li>
        <li><a href="/meditace">Meditace</a></li>
        <li><a href="/ritualy">Rituály</a></li>
        <li><a href="/terminy">Termíny</a></li>
        <li><a href="/poukaz">Dárkový poukaz</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap legal">
    {hasLegal && (
      <p>
        Provozovatel: {[legal.fullName, legal.ico && `IČO ${legal.ico}`, legal.registeredAddress].filter(Boolean).join(', ')}
      </p>
    )}
    <p>
      <a href="/ochrana-osobnich-udaju">Ochrana osobních údajů</a>
      <span aria-hidden="true"> · </span>
      Web nepoužívá cookies.
    </p>
    <p><BrushToggle /></p>
  </div>
</footer>

<style>
  .footer {
    background: var(--grain), var(--green-950);
    color: var(--fg);
    border-top: 1px solid var(--line);
    padding-block: 5rem 2rem;
    font-size: 0.95rem;
  }
  .closing {
    text-align: center;
    padding-bottom: 3.5rem;
    margin-bottom: 3.5rem;
    border-bottom: 1px solid var(--line);
  }
  .closing :global(.closing-sprig) {
    width: 11rem;
    margin: 0 auto 1.5rem;
    color: var(--gold);
    --illo-fill: var(--green-950);
  }
  .closing-name {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.4rem, 7vw, 4rem);
    line-height: 1.1;
    margin: 0 0 0.5rem;
  }
  .closing-sub {
    color: var(--fg-soft);
    margin: 0;
  }
  .grid {
    display: grid;
    gap: 1.5rem 3rem;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  }
  .brand {
    font-family: var(--font-display);
    font-size: 1.6rem;
    margin-bottom: 0.6rem;
  }
  a {
    text-decoration: none;
  }
  a:hover {
    color: var(--gold);
  }
  .muted a {
    display: inline-block;
    padding-block: 0.6rem;
    margin-block: -0.6rem;
  }
  .links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .legal {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    color: var(--fg-soft);
  }
  .legal p {
    margin: 0.25rem 0;
  }
  .legal a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }
</style>
