---
// On/off switch for the paint brush. Hidden until the brush has started (needs WebGL2).
interface Props {
  floating?: boolean;
}
const { floating = false } = Astro.props;
---
<button class:list={['brush-toggle', { floating }]} type="button" data-brush-toggle hidden aria-pressed="true"
  title="Kurzor maluje vodovkami. Klepnutím ukápnete inkoust.">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M14.5 4.5l5 5-7.5 7.5c-1 1-2.6 1.2-3.8.5" />
    <path d="M8.2 17.5c-.8 1.9-2.3 2.8-4.7 2.5.6-1.2.5-2.4.9-3.5.6-1.6 2.6-2.2 3.8-1" />
    <path d="M12.5 6.5l5 5" opacity=".5" />
  </svg>
  <span data-brush-label>Štětec: zapnutý</span>
</button>
