---
import { categories, serviceUrl } from '../data/services';
import { fromPrice } from '../lib/format';
import Paint from './Paint.astro';
---
<section class="section clip offer" id="nabidka" aria-labelledby="offer-title">
  <Paint name="blob-blush" class="wash" drift={-0.05} />
  <div class="wrap">
    <div class="head center">
      <p class="eyebrow">Moje nabídka</p>
      <h2 id="offer-title">Masáže, meditace <em>a rituály</em></h2>
      <p class="lead">Vyberte si péči, která vás právě teď nejlépe podpoří na cestě k rovnováze.</p>
    </div>

    <div class="cards">
      {categories.map((c, i) => (
        <article class="card" style={`--i:${i}`}>
          <a class="top" href={`/${c.id}`} tabindex="-1" aria-hidden="true">
            <Paint name={c.illustration} class="art" />
          </a>
          <div class="body">
            <h3><a href={`/${c.id}`}>{c.name}</a></h3>
            {c.intro && <p class="intro">{c.intro}</p>}
            <ul>
              {c.services.map((s) => (
                <li>
                  <a href={serviceUrl(c.id, s.slug)}>
                    <span class="name">{s.name}</span>
                    <span class="price">{fromPrice(s)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .offer :global(.wash) {
    position: absolute;
    width: min(50rem, 110vw);
    left: 50%;
    top: 2rem;
    margin-left: min(-25rem, -55vw);
    opacity: 0.55;
  }
  .head {
    position: relative;
    margin-bottom: 3.5rem;
  }
  .cards {
    position: relative;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19.5rem), 1fr));
    align-items: start;
  }
  .card {
    background: var(--grain), var(--paper);
    border: 1px solid var(--line);
    border-radius: 999px 999px 1.25rem 1.25rem;
    box-shadow: 0 2rem 3.5rem -2.75rem oklch(0.35 0.05 90 / 0.6);
    overflow: hidden;
  }
  .top {
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 0.8;
    padding: 2.5rem 2.5rem 0;
  }
  .top :global(.art) {
    width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  @media (prefers-reduced-motion: no-preference) {
    .top :global(.art.is-in) {
      transition: transform 0.9s var(--ease), filter 1.4s var(--ease);
    }
    .card:hover .top :global(.art) {
      transform: translateY(-6px) scale(1.04) rotate(-1.5deg);
    }
  }
  .body {
    padding: 1.25rem 1.75rem 1.5rem;
  }
  h3 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }
  h3 a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--gold-deep);
  }
  .intro {
    color: var(--fg-soft);
    font-size: 0.98rem;
    line-height: 1.6;
  }
  ul {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  li a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    min-height: 46px;
    padding: 0.6rem 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
    font-size: 0.98rem;
    line-height: 1.4;
  }
  li a:hover .name {
    color: var(--gold-deep);
  }
  .price {
    white-space: nowrap;
    color: var(--fg-soft);
    font-size: 0.9rem;
  }
</style>
