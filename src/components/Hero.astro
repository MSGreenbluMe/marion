---
import { site } from '../data/site';
import Illustration from './Illustration.astro';

const headline = site.hero.headline || site.name;
// "Péče o tělo, klid pro mysl" -> second half in italic gold
const comma = headline.indexOf(', ');
const [first, rest] = comma > 0 ? [headline.slice(0, comma + 1), headline.slice(comma + 2)] : [headline, ''];
---
<section class="hero">
  <div class="rings" aria-hidden="true"></div>
  <div class="wrap grid">
    <div class="text">
      <p class="eyebrow">{site.name} · {site.contact.city}</p>
      <h1>{first}{rest && <> <em>{rest}</em></>}</h1>
      <p class="sub">{site.hero.sub}</p>
      <div class="actions">
        <a class="btn btn-primary" href="#jak-se-citite">Vybrat, co dnes potřebuji</a>
        <a class="text-link" href="#nabidka">Celá nabídka</a>
      </div>
    </div>

    <div class="visual" aria-hidden="true">
      <div class="arch">
        <div class="glow"></div>
        <Illustration name="candle" class="candle" />
        <div class="arch-line"></div>
      </div>
      <Illustration name="sprig" class="sprig" />
      <Illustration name="stones" class="stones" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(4.5rem, 10vw, 8rem);
    background: radial-gradient(90% 70% at 75% 45%, var(--green-850), transparent 70%);
  }
  .rings {
    position: absolute;
    right: -18rem;
    top: 50%;
    width: 60rem;
    aspect-ratio: 1;
    translate: 0 -50%;
    border-radius: 50%;
    background: repeating-radial-gradient(circle, transparent 0 5.9rem, oklch(0.78 0.126 85 / 0.07) 5.9rem 6rem);
    mask-image: radial-gradient(circle, #000 30%, transparent 70%);
    pointer-events: none;
  }
  .grid {
    position: relative;
    display: grid;
    gap: 3.5rem;
    align-items: center;
  }
  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
    }
  }
  h1 {
    max-width: 11em;
    margin-bottom: 1.5rem;
  }
  h1 em {
    display: inline-block;
  }
  .sub {
    max-width: 28rem;
    font-size: 1.2rem;
    color: var(--on-dark-soft);
    margin-bottom: 2.5rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }

  .visual {
    position: relative;
    width: min(100%, 22rem);
    margin-inline: auto;
  }
  @media (max-width: 55.99rem) {
    .visual {
      width: min(62%, 13.5rem);
    }
  }
  .arch {
    aspect-ratio: 3 / 4.3;
    background:
      radial-gradient(80% 55% at 50% 52%, oklch(0.3 0.04 120), transparent 75%),
      linear-gradient(180deg, var(--green-800), var(--green-950));
    box-shadow: 0 2.5rem 5rem -2rem oklch(0.1 0.02 148 / 0.8);
  }
  /* A candle-like glow that breathes: ~4 s in, ~6 s out. Static with reduced motion. */
  .glow {
    position: absolute;
    left: 50%;
    top: 37%;
    width: 150%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      oklch(0.86 0.12 85 / 0.55) 0%,
      oklch(0.78 0.126 85 / 0.22) 16%,
      oklch(0.7 0.1 80 / 0.07) 38%,
      transparent 62%
    );
    transform: scale(0.95);
    opacity: 0.9;
    will-change: transform, opacity;
  }
  @media (prefers-reduced-motion: no-preference) {
    .glow {
      animation: breathe 10s infinite;
    }
  }
  @keyframes breathe {
    0% {
      transform: scale(0.78);
      opacity: 0.6;
      animation-timing-function: cubic-bezier(0.45, 0, 0.4, 1);
    }
    40% {
      transform: scale(1.08);
      opacity: 1;
      animation-timing-function: cubic-bezier(0.45, 0, 0.55, 1);
    }
    100% {
      transform: scale(0.78);
      opacity: 0.6;
    }
  }
  .visual :global(.candle) {
    position: absolute;
    left: 50%;
    bottom: 10%;
    width: 52%;
    translate: -50% 0;
    color: var(--gold);
    --illo-fill: oklch(0.24 0.032 140);
  }
  .visual :global(.sprig) {
    position: absolute;
    left: -24%;
    bottom: -6%;
    width: 42%;
    color: var(--gold);
    opacity: 0.85;
    --illo-fill: var(--green-900);
    rotate: -8deg;
  }
  .visual :global(.stones) {
    position: absolute;
    right: -16%;
    bottom: -4%;
    width: 38%;
    color: var(--gold-soft);
    --illo-fill: var(--green-900);
  }
</style>
