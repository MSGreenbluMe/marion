---
import { site } from '../data/site';
import Illustration from './Illustration.astro';
import Paint from './Paint.astro';

const headline = site.hero.headline || site.name;
// "Péče o tělo, klid pro mysl" -> second half in italic gold
const comma = headline.indexOf(', ');
const [first, rest] = comma > 0 ? [headline.slice(0, comma + 1), headline.slice(comma + 2)] : [headline, ''];
---
<section class="hero section clip" data-hero>
  <Paint name="blob-gold" class="wash wash-gold" settle={false} eager drift={-0.06} />
  <Paint name="blob-sage" class="wash wash-sage" settle={false} drift={0.05} />

  <div class="wrap grid">
    <div class="text">
      <p class="eyebrow">{site.name} · {site.contact.city}</p>
      <h1>{first}{rest && <> <em>{rest}</em></>}</h1>
      <p class="sub">{site.hero.sub}</p>
      <div class="actions">
        <a class="btn btn-primary" href="#jak-se-citite">Vybrat, co dnes potřebuji</a>
        <button class="breath-btn" type="button" data-breath-btn aria-pressed="false">
          <span class="breath-dot" aria-hidden="true"></span>
          <span data-breath-label>Nadechněte se se mnou</span>
        </button>
      </div>
    </div>

    <div class="visual">
      <div class="arch-wrap">
        <Paint name="arch" class="arch-paint" settle={false} eager pointer={5} />
        <div class="glow-pos" data-pointer="5" aria-hidden="true"><div class="glow" data-glow></div></div>
        <div class="candle-pos" data-pointer="5"><Illustration name="candle" class="candle" /></div>
        <p class="breath-text" data-breath-text data-pointer="5" aria-live="polite"></p>
      </div>
      <Paint name="eucalyptus" class="euca" settle={false} eager pointer={14} />
      <Paint name="stones" class="stones" settle={false} eager pointer={9} />
    </div>
  </div>
</section>

<script>
  // Guided breath: three slow breaths in time with the candle glow (4 s in, 6 s out).
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const btn = hero?.querySelector<HTMLButtonElement>('[data-breath-btn]');
  const label = hero?.querySelector<HTMLElement>('[data-breath-label]');
  const text = hero?.querySelector<HTMLElement>('[data-breath-text]');
  const glow = hero?.querySelector<HTMLElement>('[data-glow]');
  let timers: number[] = [];

  const say = (t: string) => {
    if (!text) return;
    text.classList.remove('show');
    window.setTimeout(() => {
      text.textContent = t;
      if (t) text.classList.add('show');
    }, 250);
  };
  const stop = () => {
    timers.forEach(clearTimeout);
    timers = [];
    hero?.classList.remove('breathing');
    btn?.setAttribute('aria-pressed', 'false');
    if (label) label.textContent = 'Nadechněte se se mnou';
  };
  const start = () => {
    hero?.classList.add('breathing');
    btn?.setAttribute('aria-pressed', 'true');
    if (label) label.textContent = 'Zastavit';
    // restart the glow so "in" begins now
    if (glow) {
      glow.style.animation = 'none';
      void glow.offsetWidth;
      glow.style.animation = '';
    }
    const cue = (phase: string) => window.dispatchEvent(new CustomEvent('marion:breath', { detail: phase }));
    cue('start');
    let t = 0;
    for (let i = 0; i < 3; i++) {
      timers.push(window.setTimeout(() => { say('Nádech'); cue('in'); }, t));
      timers.push(window.setTimeout(() => { say('Výdech'); cue('out'); }, t + 4000));
      t += 10000;
    }
    timers.push(window.setTimeout(() => { say('Děkuji. Teď jste tady.'); cue('end'); }, t));
    timers.push(window.setTimeout(() => { say(''); stop(); }, t + 4500));
  };
  btn?.addEventListener('click', () => (hero?.classList.contains('breathing') ? (stop(), say('')) : start()));
</script>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 5.5rem) clamp(4rem, 9vw, 7rem);
  }
  .hero :global(.wash) {
    position: absolute;
  }
  .hero :global(.wash-gold) {
    width: min(58rem, 120vw);
    left: -16rem;
    top: -6rem;
    opacity: 0.75;
  }
  .hero :global(.wash-sage) {
    width: min(44rem, 100vw);
    right: -12rem;
    bottom: -10rem;
    opacity: 0.7;
  }
  .grid {
    position: relative; /* paints above the washes; no z-index so multiply still reaches the paper */
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 3rem;
    }
  }
  h1 {
    max-width: 10.5em;
    margin-bottom: 1.5rem;
  }
  h1 em {
    white-space: nowrap;
  }
  .sub {
    max-width: 28rem;
    font-size: 1.22rem;
    color: var(--fg-soft);
    margin-bottom: 2.5rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }
  .breath-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 50px;
    padding: 0 0.25rem;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 0.98rem;
    cursor: pointer;
  }
  .breath-btn:hover [data-breath-label] {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .breath-dot {
    position: relative;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    border: 1px solid var(--gold-deep);
  }
  .breath-dot::after {
    content: '';
    position: absolute;
    inset: 0.4rem;
    border-radius: 50%;
    background: var(--gold-deep);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.breathing) .breath-dot::after {
      animation: breathe 10s infinite;
    }
  }
  :global(.breathing) .glow-pos {
    filter: brightness(1.35) saturate(1.1);
    transition: filter 1.2s var(--ease);
  }

  /* ---- painted arch */
  .visual {
    position: relative;
    width: min(100%, 25rem);
    margin-inline: auto;
  }
  @media (max-width: 55.99rem) {
    .visual {
      width: min(74%, 18rem);
    }
  }
  .arch-wrap {
    position: relative;
  }
  .arch-wrap :global(.arch-paint) {
    width: 100%;
  }
  /* The glow sits inside the painted arch. Breathes ~4 s in, ~6 s out. Static with reduced motion. */
  .glow-pos {
    position: absolute;
    left: 11%;
    right: 11%;
    top: 20%;
    aspect-ratio: 1;
    pointer-events: none;
  }
  .glow {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      oklch(0.9 0.11 85 / 0.7) 0%,
      oklch(0.8 0.12 82 / 0.32) 18%,
      oklch(0.7 0.1 80 / 0.1) 42%,
      transparent 66%
    );
    transform: scale(0.95);
    opacity: 0.9;
  }
  @media (prefers-reduced-motion: no-preference) {
    .glow {
      animation: breathe 10s infinite;
    }
  }
  @keyframes breathe {
    0% {
      transform: scale(0.74);
      opacity: 0.55;
      animation-timing-function: cubic-bezier(0.45, 0, 0.4, 1);
    }
    40% {
      transform: scale(1.1);
      opacity: 1;
      animation-timing-function: cubic-bezier(0.45, 0, 0.55, 1);
    }
    100% {
      transform: scale(0.74);
      opacity: 0.55;
    }
  }
  .candle-pos {
    position: absolute;
    left: 32%;
    width: 36%;
    top: 49%;
  }
  .candle-pos :global(.candle) {
    width: 100%;
    color: var(--gold);
    --illo-fill: oklch(0.27 0.04 145);
  }
  .breath-text {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 22%;
    margin: 0;
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.5rem, 3.4vw, 2.1rem);
    line-height: 1.2;
    color: var(--paper);
    opacity: 0;
    transition: opacity 0.6s var(--ease);
  }
  .breath-text:global(.show) {
    opacity: 1;
  }
  .visual :global(.euca) {
    position: absolute;
    left: -27%;
    bottom: 2%;
    width: 44%;
    rotate: -10deg;
  }
  .visual :global(.stones) {
    position: absolute;
    right: -24%;
    bottom: -6%;
    width: 52%;
  }
</style>
