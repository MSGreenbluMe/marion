---
import Base from '../layouts/Base.astro';
import { categories, serviceUrl, type Category } from '../data/services';
import { fromPrice, lengthSummary } from '../lib/format';
import Paint from '../components/Paint.astro';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { category: category.id }, props: { category } }));
}
const { category } = Astro.props as { category: Category };
const others = categories.filter((c) => c.id !== category.id);
---
<Base title={category.name} description={category.metaDescription}>
  <section class="section clip page">
    <div class="wrap">
      <header class="head">
        <div>
          <p class="eyebrow">Moje nabídka</p>
          <h1>{category.name}</h1>
          {category.intro && <p class="lead">{category.intro}</p>}
        </div>
        <div class="head-art">
          <Paint name="arch-soft" class="head-arch" eager settle={false} />
          <Paint name={category.illustration} class="head-illo" eager settle={false} />
        </div>
      </header>

      <ul class="list">
        {category.services.map((s) => (
          <li>
            <a href={serviceUrl(category.id, s.slug)}>
              <span class="main">
                <span class="name">{s.name}</span>
                {s.summary && <span class="summary">{s.summary}</span>}
              </span>
              <span class="side">
                <span class="price">{fromPrice(s)}</span>
                {lengthSummary(s) && <span class="length">{lengthSummary(s)}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>

      <p class="others">
        {others.map((o) => <a class="text-link" href={`/${o.id}`}>{o.name}</a>)}
      </p>
    </div>
  </section>
</Base>

<style>
  .page {
    padding-top: clamp(3rem, 7vw, 5.5rem);
  }
  .head {
    display: grid;
    gap: 2.5rem;
    align-items: end;
  }
  @media (min-width: 48rem) {
    .head {
      grid-template-columns: 1fr 15rem;
      gap: 4rem;
    }
  }
  .head-art {
    position: relative;
    width: min(55%, 13rem);
  }
  @media (min-width: 48rem) {
    .head-art {
      width: 100%;
    }
  }
  .head-art :global(.head-arch) {
    width: 100%;
  }
  .head-art :global(.head-illo) {
    position: absolute;
    left: 5%;
    width: 90%;
    bottom: 10%;
  }
  .list {
    list-style: none;
    padding: 0;
    margin: 4rem 0 3rem;
    border-top: 1px solid var(--line);
  }
  .list a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem 2rem;
    padding: 1.6rem 0;
    min-height: 44px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .main {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.4vw, 2rem);
    line-height: 1.2;
  }
  .list a:hover .name {
    color: var(--gold-deep);
  }
  .summary {
    color: var(--fg-soft);
    max-width: var(--measure);
  }
  .side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    flex-shrink: 0;
  }
  .price {
    color: var(--ink);
    font-weight: 400;
    white-space: nowrap;
  }
  .length {
    font-size: 0.9rem;
    color: var(--fg-soft);
    white-space: nowrap;
  }
  .others {
    display: flex;
    gap: 1.5rem;
  }
</style>
