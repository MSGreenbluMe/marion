---
import Base from '../layouts/Base.astro';
import { categories, serviceUrl, type Category } from '../data/services';
import { fromPrice, lengthSummary } from '../lib/format';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { category: category.id }, props: { category } }));
}
const { category } = Astro.props as { category: Category };
const others = categories.filter((c) => c.id !== category.id);
---
<Base title={category.name} description={category.metaDescription}>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Moje nabídka</p>
      <h1>{category.name}</h1>
      {category.intro && <p class="lead">{category.intro}</p>}

      <ul class="list">
        {category.services.map((s) => (
          <li>
            <a href={serviceUrl(category.id, s.slug)}>
              <span class="main">
                <span class="name">{s.name}</span>
                {s.summary && <span class="summary">{s.summary}</span>}
              </span>
              <span class="side">
                <span class="price">{fromPrice(s)}</span>
                {lengthSummary(s) && <span class="length">{lengthSummary(s)}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>

      <p class="others">
        {others.map((o) => <a class="text-link" href={`/${o.id}`}>{o.name}</a>)}
      </p>
    </div>
  </section>
</Base>

<style>
  .list {
    list-style: none;
    padding: 0;
    margin: 3.5rem 0 3rem;
    border-top: 1px solid var(--line-dark);
  }
  .list a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem 2rem;
    padding: 1.6rem 0;
    min-height: 44px;
    border-bottom: 1px solid var(--line-dark);
    text-decoration: none;
  }
  .main {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.4vw, 2rem);
    line-height: 1.2;
  }
  .list a:hover .name {
    color: var(--gold);
  }
  .summary {
    color: var(--on-dark-soft);
    max-width: var(--measure);
  }
  .side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    flex-shrink: 0;
  }
  .price {
    color: var(--gold);
    white-space: nowrap;
  }
  .length {
    font-size: 0.9rem;
    color: var(--on-dark-soft);
    white-space: nowrap;
  }
  .others {
    display: flex;
    gap: 1.5rem;
  }
</style>
