---
import Base from '../layouts/Base.astro';
import Paint from '../components/Paint.astro';
---
<Base title="Stránka nenalezena" description="Tato stránka neexistuje.">
  <section class="section">
    <div class="wrap measure center">
      <Paint name="lotus" class="lost" eager settle={false} />
      <h1>Tady nic <em>není</em></h1>
      <p class="lead">Stránka, kterou hledáte, neexistuje nebo se přesunula.</p>
      <p><a class="text-link" href="/">Zpět na úvod</a></p>
    </div>
  </section>
</Base>

<style>
  .center :global(.lost) {
    width: min(20rem, 80%);
    margin: 0 auto 1rem;
  }
</style>
